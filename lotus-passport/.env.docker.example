# ===== Lotus Passport — Docker production env template =====
# Copy to `.env.docker` and fill in real values. This file is git-ignored and is
# injected into the `web` container via `env_file` (NEVER baked into the image).
#
# Generate the secrets locally (do NOT commit them):
#   SECRET_KEY:
#     python -c "import secrets; print(secrets.token_urlsafe(50))"
#   TOKEN_ENCRYPTION_KEY (base64 of 32 random bytes, for AES-256-CBC):
#     python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
#   RS256 keypair: nothing to do — the entrypoint runs `manage.py generate_keys`
#     on first boot into the `passport_keys` volume. See the JWT section below.

# ---- Core ----
DEBUG=False
SECRET_KEY=__GENERATE_WITH_token_urlsafe_50__
ALLOWED_HOSTS=passport.eacm.cn,localhost,127.0.0.1

# Force HTTP -> HTTPS at the Django layer. Leave False while the stack still
# serves plain :80 (nginx TLS block commented out) — enabling it without a 443
# listener causes a redirect loop. Set True as soon as real certs are mounted.
SECURE_SSL_REDIRECT=False

# ---- Database / Redis ----
# These are overridden in docker-compose.yml for the in-stack hosts, but kept here
# so the same file also works if you ever point at an external DB/redis.
DATABASE_URL=postgres://passport:passport@db:5432/passport
REDIS_URL=redis://redis:6379/0

# ---- JWT (RS256, recommended) ----
# DEFAULT (and what docker-compose.yml is wired for): file-backed key store in
# /app/keys, persisted by the `passport_keys` volume. The entrypoint generates
# the initial keypair on first boot; rotate later with
#   docker compose exec web python manage.py rotate_keys
# Old public keys stay in the JWKS for --retention-days so live refresh tokens
# survive the rotation. >>> BACK UP THE `passport_keys` VOLUME. <<<
JWT_USE_RS256=True
# PASSPORT_JWT_KEYS_DIR=/app/keys   # already the image default

# ALTERNATIVE — externally managed PEM (secret manager / docker secret / k8s).
# Setting BOTH switches the key store to env mode: nothing is written to disk
# and `rotate_keys` is refused (you rotate by swapping these two values and
# doing a rolling restart).
# CAUTION: do NOT put these in this file. Compose `env_file` cannot carry the
# multi-line PEM text; pass them through a secret mount or an orchestrator
# secret instead.
# PASSPORT_JWT_PRIVATE_KEY=<full PEM incl. BEGIN/END lines>
# PASSPORT_JWT_PUBLIC_KEY=<full PEM incl. BEGIN/END lines>

# ---- AES-256-CBC key (base64 of 32 bytes) for third-party token encryption ----
TOKEN_ENCRYPTION_KEY=__GENERATE_WITH_base64_urandom_32__

# ---- OAuth redirect base + post-login redirect ----
# Overridden in docker-compose.yml; values shown for reference.
PASSPORT_OAUTH_REDIRECT_BASE=https://passport.eacm.cn/api/v1/oauth
FRONTEND_SUCCESS_REDIRECT=https://passport.eacm.cn/

# ---- CORS — origins of integrating apps (e.g. E-algo rank frontend) ----
CORS_ALLOWED_ORIGINS=https://algo-rank.emoera.com

# ---- Allowed post-login redirect_uri values (open-redirect mitigation, A-11) ----
# Comma-separated. Origin-only (https://x.com) matches any path; with a path
# (https://x.com/cb) is an exact match. localhost auto-allowed only under
# DEBUG/TESTING, so PRODUCTION MUST list every integrating app's callback here.
# Include this deployment's own SPA origin — nginx serves it at `/`, and
# FRONTEND_SUCCESS_REDIRECT points back to it.
OAUTH_ALLOWED_REDIRECT_URIS=https://passport.eacm.cn,https://algo-rank.emoera.com

# ---- Server-side token revocation (real logout) ----
# When True, POST /api/v1/logout/ blacklists the token jti (enforced at
# /api/v1/userinfo/). Offline-verifying integrators only re-check on expiry.
# TOKEN_REVOCATION_ENABLED=True

# ---- Provider credentials ----
# The "Authorization callback URL" registered at each provider MUST equal:
#   ${PASSPORT_OAUTH_REDIRECT_BASE}/<provider>/callback/
# Until set, /api/v1/oauth/<provider>/login/ returns HTTP 400.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WECHAT_CLIENT_ID=
WECHAT_CLIENT_SECRET=
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=
