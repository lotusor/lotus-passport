# Lotus Passport — 生产环境变量模板(.env.production.example)
# 复制为 `.env`(或 `.env.production`)后填入真实值。本模板可提交仓库,不含任何真实密钥。
# 域名体系(已定):后端 passport.eacm.cn / 通行证前端 account.eacm.cn / 项目1 rank.eacm.cn。

# --- 基础 / 调试开关 ---
DEBUG=false
ENABLE_DEV_LOGIN=false
SECRET_KEY=<generate: python -c "import secrets;print(secrets.token_hex(32))">
TOKEN_ENCRYPTION_KEY=<generate: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())">

# --- 域名 / 主机 ---
ALLOWED_HOSTS=passport.eacm.cn
PASSPORT_OAUTH_REDIRECT_BASE=https://passport.eacm.cn/api/v1/oauth
FRONTEND_SUCCESS_REDIRECT=https://account.eacm.cn/
OAUTH_ALLOWED_REDIRECT_URIS=https://account.eacm.cn,https://rank.eacm.cn
CORS_ALLOWED_ORIGINS=https://account.eacm.cn,https://rank.eacm.cn

# --- 数据库 / 缓存(生产用 PostgreSQL + Redis;CHANGE_ME 处填真实内网地址与账号密码)---
DATABASE_URL=postgres://CHANGE_ME_USER:CHANGE_ME_PW@CHANGE_ME_HOST:5432/lotus_passport
REDIS_URL=redis://CHANGE_ME_HOST:6379/0

# --- 令牌吊销(真实登出)---
TOKEN_REVOCATION_ENABLED=true

# --- OAuth:GitHub(client_id 已固定;secret 从 GitHub OAuth App 控制台获取)---
GITHUB_CLIENT_ID=Ov23liFazgN9Q6P73HAT
GITHUB_CLIENT_SECRET=<from GitHub OAuth App>
# 微信 / QQ:网站正式上线 + 登记可信域名后再申请,当前留空(返回 400 预留)。
WECHAT_CLIENT_ID=
WECHAT_CLIENT_SECRET=
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=

# --- CAPTCHA(hCaptcha;Secret 从 hCaptcha 控制台获取,控制台 Hostnames 需含 passport.eacm.cn)---
HCAPTCHA_SECRET_KEY=<from hCaptcha dashboard>
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_TRIGGER_THRESHOLD=3

# --- 传输安全 ---
SECURE_SSL_REDIRECT=true
# 收窄为真实 nginx 段。单主机 Docker 常见为 127.0.0.1(本机)+ 172.16.0.0/12(docker bridge)。
TRUSTED_PROXY_CIDRS=127.0.0.1,172.16.0.0/12

# --- RS256 密钥:切勿在此填写私钥。部署时执行 `python manage.py generate_keys` ---
# 写入 keys/ 目录(manifest.json + private_<kid>.pem / public_<kid>.pem),挂载为持久卷并离线备份。
# 丢私钥 = 所有已签发 JWT 失效,需令所有接入方重新登录。
