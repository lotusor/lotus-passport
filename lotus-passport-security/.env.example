# ---------------------------------------------------------------------------
# Lotus Passport Security (Next.js SPA) — environment template
#
# Copy to `.env.local` for local dev:   cp .env.example .env.local
# In Docker/compose these are passed as container env, NOT via this file.
#
# NOTE: every variable here is SERVER-SIDE only (no NEXT_PUBLIC_ prefix).
# The browser never talks to the backend directly — it calls the same-origin
# path /api/v1/*, which app/api/v1/[...path]/route.ts proxies onward. That is
# why there is no CORS setup and no public API URL to leak.
# ---------------------------------------------------------------------------

# Origin of the Django passport backend, as reachable FROM THE NODE PROCESS.
#   local dev      : http://localhost:8000
#   docker compose : http://web:8000        (compose service name)
#   split deploy   : https://passport.eacm.cn
PASSPORT_API_ORIGIN=http://localhost:8000

# Port `next start` listens on. Defaults to 3000; the Docker image sets
# HOSTNAME=0.0.0.0 so the container is reachable from nginx.
# PORT=3000
